<%
  // Derive button label from the current user's RSVP status:
  //   null / undefined  → no RSVP yet       → "RSVP"
  //   "going"           → active RSVP        → "Cancel RSVP"
  //   "waitlisted"      → on waitlist        → "Cancel RSVP"
  //   "cancelled"       → previously cancel  → "RSVP Again"
  let buttonLabel;
  if (rsvpStatus === "going" || rsvpStatus === "waitlisted") {
    buttonLabel = "Cancel RSVP";
  } else if (rsvpStatus === "cancelled") {
    buttonLabel = "RSVP Again";
  } else {
    buttonLabel = "RSVP";
  }
%>

<% if (error) { %>
  <p style="color: red;"><%= error %></p>
<% } %>

<%
  let initialStatus;
  if (rsvpStatus === "going") {
    initialStatus = "Attending";
  } else if (rsvpStatus === "waitlisted") {
    initialStatus = "Waitlisted";
  } else if (rsvpStatus === "cancelled") {
    initialStatus = "Cancelled";
  } else {
    initialStatus = "RSVP";
  }
%>

<div x-data="{
    status: '<%= initialStatus %>',
    capacity: <%= capacity %>,
    attendeeCount: <%= attendeeCount %>,
    toggle() {
      if (this.status === 'Attending' || this.status === 'Waitlisted') {
        this.status = 'Cancelled'
        this.attendeeCount--
      } else {
        this.attendeeCount++
        this.status = this.attendeeCount < this.capacity ? 'Attending' : 'Waitlisted'
      }
    }
  }">
      
    <input type="hidden" name="status" :value="status" />

    <button 
      @click= "toggle()"
      hx-post="/events/<%= eventId %>/rsvp"
      hx-target="#rsvp-container"
      hx-swap="innerHTML"
      hx-include="closest div"
      :class="{ 'bg-blue-600 hover:bg-blue-700': status == 'RSVP',
        'bg-green-600 hover:bg-green-700': status == 'Attending',
        'bg-yellow-300 hover:bg-yellow-400': status == 'Waitlisted',
        'bg-red-600 hover:bg-red-700': status == 'Cancelled' }"
      class="px-4 py-2 rounded-lg text-white font-medium cursor-pointer text-sm"
    >
      <span x-text="status"></span>
    </button>
  </div>

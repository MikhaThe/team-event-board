<div id="status-area"
  x-data="{ visible: false }"
  x-init="requestAnimationFrame(() => visible = true)"
  :class="visible ? 'opacity-100 translate-y-0' : 'opacity-0 -translate-y-1'"
  class="transition-all duration-300 flex items-center gap-3 flex-wrap">

  <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-sm font-semibold
    <%= event.status === 'published' ? 'bg-green-100 text-green-700 ring-1 ring-green-200' :
        event.status === 'draft'     ? 'bg-yellow-100 text-yellow-700 ring-1 ring-yellow-200' :
        event.status === 'cancelled' ? 'bg-red-100 text-red-500 ring-1 ring-red-200' :
                                       'bg-blue-100 text-blue-600 ring-1 ring-blue-200' %>">
    <span class="w-2 h-2 rounded-full
      <%= event.status === 'published' ? 'bg-green-500' :
          event.status === 'draft'     ? 'bg-yellow-500' :
          event.status === 'cancelled' ? 'bg-red-400' :
                                         'bg-blue-400' %>"></span>
    <%= event.status.charAt(0).toUpperCase() + event.status.slice(1) %>
  </span>

  <% if (canAct && event.status === 'draft') { %>
    <form method="post" action="/events/<%= event.id %>/publish" class="m-0"
      hx-post="/events/<%= event.id %>/publish"
      hx-target="#status-area"
      hx-swap="outerHTML">
      <button type="submit"
        class="px-3 py-1 rounded-full bg-green-600 text-white text-sm font-medium hover:bg-green-700 transition-colors cursor-pointer">
        Publish
      </button>
    </form>
  <% } else if (canAct && event.status === 'published') { %>
    <form method="post" action="/events/<%= event.id %>/cancel" class="m-0"
      hx-post="/events/<%= event.id %>/cancel"
      hx-target="#status-area"
      hx-swap="outerHTML"
      hx-confirm="Are you sure you want to cancel this event? This cannot be undone.">
      <button type="submit"
        class="px-3 py-1 rounded-full border border-red-200 bg-red-50 text-red-600 text-sm font-medium hover:bg-red-100 transition-colors cursor-pointer">
        Cancel Event
      </button>
    </form>
  <% } %>
</div>

<div class="max-w-3xl mx-auto">
  <div class="bg-white rounded-2xl shadow-lg border border-slate-200 overflow-hidden">

    <div class="p-8 border-b border-slate-100">
      <div class="flex items-start justify-between gap-4 flex-wrap">
        <div>
          <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold mb-3 bg-blue-100 text-blue-700">
            editing
          </span>
          <h1 class="text-3xl font-bold text-slate-900">Edit Event</h1>
          <p class="text-slate-500 mt-1">Make changes and save when you're done</p>
        </div>
      </div>
    </div>

    <form
      hx-post="/events/<%= event.id %>/edit"
      hx-target="#event-container"
      hx-swap="innerHTML"
      class="p-8 space-y-6"
      x-data="{ dirty: false, confirming: false }"
      @change="dirty = true"
      @htmx:before-request="dirty = false"
      x-effect="
        const handler = e => { if (dirty) e.preventDefault(); };
        window.addEventListener('beforeunload', handler);
        $cleanup(() => window.removeEventListener('beforeunload', handler));
      "
    >
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

        <div class="bg-slate-50 rounded-xl p-4 sm:col-span-2">
          <label class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-2 block" for="title">Title</label>
          <input id="title" name="title" value="<%= event.title %>"
            class="w-full bg-white border border-slate-200 rounded-lg px-3 py-2 text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
        </div>

        <div class="bg-slate-50 rounded-xl p-4 sm:col-span-2">
          <label class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-2 block" for="description">Description</label>
          <textarea id="description" name="description" rows="4"
            class="w-full bg-white border border-slate-200 rounded-lg px-3 py-2 text-slate-700 leading-relaxed focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent resize-none"><%= event.description %></textarea>
        </div>

        <div class="bg-slate-50 rounded-xl p-4">
          <label class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-2 block" for="location">Location</label>
          <input id="location" name="location" value="<%= event.location %>"
            class="w-full bg-white border border-slate-200 rounded-lg px-3 py-2 text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
        </div>

        <div class="bg-slate-50 rounded-xl p-4">
          <label class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-2 block" for="category">Category</label>
          <input id="category" name="category" value="<%= event.category %>"
            class="w-full bg-white border border-slate-200 rounded-lg px-3 py-2 text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
        </div>

        <div class="bg-slate-50 rounded-xl p-4">
          <label class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-2 block" for="startDatetime">Start</label>
          <input id="startDatetime" name="startDatetime" type="datetime-local" value="<%= event.startDatetime %>"
            class="w-full bg-white border border-slate-200 rounded-lg px-3 py-2 text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
        </div>

        <div class="bg-slate-50 rounded-xl p-4">
          <label class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-2 block" for="endDatetime">End</label>
          <input id="endDatetime" name="endDatetime" type="datetime-local" value="<%= event.endDatetime %>"
            class="w-full bg-white border border-slate-200 rounded-lg px-3 py-2 text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
        </div>

        <div class="bg-slate-50 rounded-xl p-4">
          <label class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-2 block" for="capacity">Capacity</label>
          <input id="capacity" name="capacity" type="number" value="<%= event.capacity ?? '' %>" placeholder="No limit"
            class="w-full bg-white border border-slate-200 rounded-lg px-3 py-2 text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
        </div>

        <div class="bg-slate-50 rounded-xl p-4">
          <label class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-2 block" for="status">Status</label>
          <select id="status" name="status"
            class="w-full bg-white border border-slate-200 rounded-lg px-3 py-2 text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent">
            <option value="draft" <%= event.status === 'draft' ? 'selected' : '' %>>Draft</option>
            <option value="published" <%= event.status === 'published' ? 'selected' : '' %>>Published</option>
            <option value="cancelled" <%= event.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
          </select>
        </div>

      </div>

      <div class="flex gap-3 flex-wrap pt-2">
        <button type="submit"
          class="px-4 py-2 rounded-lg bg-blue-600 text-white font-medium hover:bg-blue-700 cursor-pointer">
          Save Changes
        </button>
        <button
          type="button"
          @click="
            if (dirty) {
              confirming = true;
            } else {
              htmx.ajax('GET', '/events/<%= event.id %>', {target: '#event-container', swap: 'innerHTML'})
            }
          "
          class="px-4 py-2 rounded-lg bg-slate-100 text-slate-700 font-medium hover:bg-slate-200 cursor-pointer">
          Cancel
        </button>
      </div>

      <!-- Unsaved changes confirmation -->
      <div
        x-show="confirming"
        x-transition
        class="p-4 rounded-xl bg-yellow-50 border border-yellow-200 flex items-center gap-4 flex-wrap">
        <p class="text-sm text-yellow-800 flex-1">You have unsaved changes. Are you sure you want to leave?</p>
        <button
          type="button"
          @click="dirty = false; htmx.ajax('GET', '/events/<%= event.id %>', {target: '#event-container', swap: 'innerHTML'})"
          class="px-3 py-1.5 rounded-lg bg-yellow-600 text-white text-xs font-medium hover:bg-yellow-700 cursor-pointer">
          Leave anyway
        </button>
        <button
          type="button"
          @click="confirming = false"
          class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 text-slate-600 text-xs font-medium hover:bg-slate-50 cursor-pointer">
          Keep editing
        </button>
      </div>

    </form>
  </div>
</div>
<div id="rsvpdashboard-content" class="space-y-6">
  <!-- Upcoming Events -->
  <section class="bg-white rounded-2xl shadow-lg border border-slate-200 p-5">
    <h2 class="text-lg font-semibold mb-4 text-slate-800">Upcoming Events</h2>
    <% if (dashboard.upcoming.length === 0) { %>
      <p class="text-slate-500">No upcoming events.</p>
    <% } else { %>
      <ul class="space-y-4">
        <% dashboard.upcoming.forEach(event => { %>
          <li
            class="p-4 rounded-xl border border-slate-200 hover:shadow-md transition"
            x-data="{ confirming: false }"
          >
            <div class="flex justify-between items-start gap-3">
              <div>
                <h3 class="text-base font-semibold text-slate-900">
                  <a href="/events/<%= event.eventId %>" class="hover:underline">
                    <%= event.title %>
                  </a>
                </h3>
                <p class="text-sm text-slate-500 mt-1">
                  <strong>When:</strong>
                  <%= new Date(event.startDatetime).toLocaleString() %>
                </p>
                <p class="text-sm text-slate-500">
                  <strong>Location:</strong> <%= event.location %>
                </p>
              </div>
              <span class="px-2.5 py-1 rounded-lg text-xs font-medium
                <%= event.status === 'going' ? 'bg-green-100 text-green-700' :
                    event.status === 'waitlisted' ? 'bg-yellow-100 text-yellow-700' :
                    'bg-slate-100 text-slate-600' %>">
                <%= event.status %>
              </span>
            </div>

            <!-- Cancel button -->
            <div class="mt-3" x-show="!confirming">
              <button
                @click="confirming = true"
                class="text-xs text-red-500 hover:text-red-700 font-medium cursor-pointer">
                Cancel RSVP
              </button>
            </div>

            <!-- Confirmation prompt -->
            <!-- Confirmation prompt -->
            <div
              x-show="confirming"
              x-transition
              class="mt-3 flex items-center gap-3 p-3 rounded-lg bg-red-50 border border-red-100">
              <p class="text-sm text-red-700 flex-1">Cancel your RSVP for <strong><%= event.title %></strong>?</p>
              <button
                hx-post="/events/<%= event.eventId %>/rsvp/cancel"
                hx-target="closest li"
                hx-swap="outerHTML"
                hx-on::after-request="confirming = false"
                class="px-3 py-1 rounded-lg bg-red-600 text-white text-xs font-medium hover:bg-red-700 cursor-pointer">
                Yes, cancel
              </button>
              <button
                @click="confirming = false"
                class="px-3 py-1 rounded-lg bg-white border border-slate-200 text-slate-600 text-xs font-medium hover:bg-slate-50 cursor-pointer">
                Keep
              </button>
            </div>

          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>

  <section class="bg-white rounded-2xl shadow-lg border border-slate-200 p-5">
    <h2 class="text-lg font-semibold mb-4 text-slate-800">Past Events</h2>
    <% if (dashboard.past.length === 0) { %>
      <p class="text-slate-500">No past events.</p>
    <% } else { %>
      <ul class="space-y-4">
        <% dashboard.past.forEach(event => { %>
          <li class="p-4 rounded-xl border border-slate-200 bg-slate-50">
            <div class="flex justify-between items-start gap-3">
              <div>
                <h3 class="text-base font-semibold text-slate-700">
                  <%= event.title %>
                </h3>
                <p class="text-sm text-slate-500 mt-1">
                  <strong>When:</strong>
                  <%= new Date(event.startDatetime).toLocaleString() %>
                </p>
                <p class="text-sm text-slate-500">
                  <strong>Location:</strong> <%= event.location %>
                </p>
              </div>
              <span class="px-2.5 py-1 rounded-lg text-xs font-medium bg-slate-200 text-slate-600">
                <%= event.status %>
              </span>
            </div>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>
</div>
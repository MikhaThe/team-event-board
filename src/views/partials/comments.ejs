<div id="comments-section" class="px-6 pb-6 pt-4 border-t border-slate-100">
  <h2 class="text-sm font-semibold text-slate-700 uppercase tracking-wide mb-4">
    Comments
    <% if (comments.length > 0) { %>
      <span class="ml-1 text-xs font-normal text-slate-400 normal-case">(<%= comments.length %>)</span>
    <% } %>
  </h2>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="mb-3 px-3 py-2 rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm">
      <%= error %>
    </div>
  <% } %>

  <!-- Comment list -->
  <div class="space-y-3 mb-4">
    <% if (comments.length === 0) { %>
      <p class="text-sm text-slate-400 italic">No comments yet. Be the first to say something.</p>
    <% } else { %>
      <% comments.forEach(function(comment) { %>
        <div class="flex gap-3">
          <!-- Avatar -->
          <div class="w-8 h-8 rounded-full flex-shrink-0 flex items-center justify-center text-xs font-bold
            <%= comment.isOrganizer ? 'bg-blue-100 text-blue-700' : 'bg-slate-100 text-slate-600' %>">
            <%= comment.userName.charAt(0).toUpperCase() %>
          </div>
          <!-- Bubble -->
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 mb-0.5 flex-wrap">
              <span class="text-sm font-semibold text-slate-800"><%= comment.userName %></span>
              <% if (comment.isOrganizer) { %>
                <span class="text-xs px-1.5 py-0.5 rounded bg-blue-100 text-blue-600 font-medium">Organizer</span>
              <% } %>
              <span class="text-xs text-slate-400">
                <%= new Date(comment.createdAt).toLocaleDateString("en-US", { month: "short", day: "numeric", hour: "numeric", minute: "2-digit" }) %>
              </span>
            </div>
            <p class="text-sm text-slate-700 leading-snug break-words"><%= comment.body %></p>
          </div>
        </div>
      <% }) %>
    <% } %>
  </div>

  <!-- Post form -->
  <% if (canPost) { %>
    <form
      hx-post="/events/<%= eventId %>/comments"
      hx-target="#comments-section"
      hx-swap="outerHTML"
      class="flex gap-2 items-start"
    >
      <input
        type="text"
        name="body"
        placeholder="Write a comment…"
        maxlength="500"
        autocomplete="off"
        class="flex-1 px-3 py-2 text-sm rounded-lg border border-slate-200 bg-white focus:outline-none focus:ring-2 focus:ring-blue-400 placeholder-slate-400"
        x-data
        @keydown.enter.prevent="$el.closest('form').dispatchEvent(new Event('submit', {bubbles:true}))"
      />
      <button
        type="submit"
        class="px-4 py-2 rounded-lg bg-blue-600 text-white text-sm font-medium hover:bg-blue-700 transition-colors cursor-pointer shrink-0"
      >
        Post
      </button>
    </form>
    <p class="text-xs text-slate-400 mt-1">Only attendees who are going and the organizer can post.</p>
  <% } %>
</div>

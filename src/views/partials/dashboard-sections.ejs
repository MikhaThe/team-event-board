<% if (pageError) { %>
  <%- include("./error", { message: pageError }) %>
<% } %>

<% const totalEvents = dashboard.draft.length + dashboard.published.length + dashboard.cancelled.length + dashboard.past.length; %>

<% if (totalEvents === 0) { %>
  <div class="p-8 border border-slate-200 rounded-2xl bg-white shadow-sm text-center">
    <p class="text-slate-500">You have not created any events yet.</p>
  </div>
<% } %>

<% if (dashboard.published.length > 0) { %>
  <section class="mb-6 border-l-4 border-green-400 pl-4">
    <h2 class="text-lg font-semibold text-green-700 mb-3 flex items-center gap-2">
      <span class="w-2.5 h-2.5 rounded-full bg-green-500"></span>
      Published
      <span class="text-sm font-normal text-slate-400">(<%= dashboard.published.length %>)</span>
    </h2>
    <div class="flex flex-col gap-3">
      <% for (const event of dashboard.published) { %>
        <%- include("./event-card", { event, action: "cancel" }) %>
      <% } %>
    </div>
  </section>
<% } %>

<% if (dashboard.draft.length > 0) { %>
  <section class="mb-6 border-l-4 border-yellow-400 pl-4">
    <h2 class="text-lg font-semibold text-yellow-700 mb-3 flex items-center gap-2">
      <span class="w-2.5 h-2.5 rounded-full bg-yellow-400"></span>
      Draft
      <span class="text-sm font-normal text-slate-400">(<%= dashboard.draft.length %>)</span>
    </h2>
    <div class="flex flex-col gap-3">
      <% for (const event of dashboard.draft) { %>
        <%- include("./event-card", { event, action: "publish" }) %>
      <% } %>
    </div>
  </section>
<% } %>

<% if (dashboard.past.length > 0 || dashboard.cancelled.length > 0) { %>
  <section
    x-data="{ open: false }"
    class="mb-6 border-l-4 border-slate-300 pl-4">
    <button
      @click="open = !open"
      class="w-full flex items-center gap-2 text-lg font-semibold text-slate-500 hover:text-slate-700 mb-3 transition-colors">
      <span class="w-2.5 h-2.5 rounded-full bg-slate-400 shrink-0"></span>
      Closed
      <span class="text-sm font-normal text-slate-400">(<%= dashboard.past.length + dashboard.cancelled.length %>)</span>
      <svg
        class="ml-auto w-4 h-4 text-slate-400 transition-transform duration-200"
        :class="open ? 'rotate-180' : ''"
        xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="m19 9-7 7-7-7" />
      </svg>
    </button>
    <div
      x-show="open"
      x-transition:enter="transition ease-out duration-200"
      x-transition:enter-start="opacity-0 -translate-y-2"
      x-transition:enter-end="opacity-100 translate-y-0"
      x-transition:leave="transition ease-in duration-150"
      x-transition:leave-start="opacity-100 translate-y-0"
      x-transition:leave-end="opacity-0 -translate-y-2"
      class="flex flex-col gap-3">
      <% for (const event of dashboard.past) { %>
        <%- include("./event-card", { event, action: null }) %>
      <% } %>
      <% for (const event of dashboard.cancelled) { %>
        <%- include("./event-card", { event, action: null }) %>
      <% } %>
    </div>
  </section>
<% } %>

<% if (pageError) { %>
  <%- include("./error", { message: pageError }) %>
<% } %>

<% const totalEvents = dashboard.draft.length + dashboard.published.length + dashboard.cancelled.length + dashboard.past.length; %>

<% if (totalEvents === 0) { %>
  <div class="p-8 border border-slate-200 rounded-2xl bg-white shadow-sm text-center">
    <p class="text-slate-500">You have not created any events yet.</p>
  </div>
<% } %>

<% if (dashboard.published.length > 0) { %>
  <section class="mb-6">
    <h2 class="text-lg font-semibold text-slate-700 mb-3 flex items-center gap-2">
      <span class="w-2.5 h-2.5 rounded-full bg-green-500"></span>
      Published
      <span class="text-sm font-normal text-slate-400">(<%= dashboard.published.length %>)</span>
    </h2>
    <div class="flex flex-col gap-3">
      <% for (const event of dashboard.published) { %>
        <%- include("./event-card", { event, action: "cancel" }) %>
      <% } %>
    </div>
  </section>
<% } %>

<% if (dashboard.draft.length > 0) { %>
  <section class="mb-6">
    <h2 class="text-lg font-semibold text-slate-700 mb-3 flex items-center gap-2">
      <span class="w-2.5 h-2.5 rounded-full bg-yellow-400"></span>
      Draft
      <span class="text-sm font-normal text-slate-400">(<%= dashboard.draft.length %>)</span>
    </h2>
    <div class="flex flex-col gap-3">
      <% for (const event of dashboard.draft) { %>
        <%- include("./event-card", { event, action: "publish" }) %>
      <% } %>
    </div>
  </section>
<% } %>

<% if (dashboard.past.length > 0) { %>
  <section class="mb-6">
    <h2 class="text-lg font-semibold text-slate-700 mb-3 flex items-center gap-2">
      <span class="w-2.5 h-2.5 rounded-full bg-blue-400"></span>
      Past
      <span class="text-sm font-normal text-slate-400">(<%= dashboard.past.length %>)</span>
    </h2>
    <div class="flex flex-col gap-3">
      <% for (const event of dashboard.past) { %>
        <%- include("./event-card", { event, action: null }) %>
      <% } %>
    </div>
  </section>
<% } %>

<% if (dashboard.cancelled.length > 0) { %>
  <section class="mb-6">
    <h2 class="text-lg font-semibold text-slate-700 mb-3 flex items-center gap-2">
      <span class="w-2.5 h-2.5 rounded-full bg-slate-400"></span>
      Cancelled
      <span class="text-sm font-normal text-slate-400">(<%= dashboard.cancelled.length %>)</span>
    </h2>
    <div class="flex flex-col gap-3">
      <% for (const event of dashboard.cancelled) { %>
        <%- include("./event-card", { event, action: null }) %>
      <% } %>
    </div>
  </section>
<% } %>

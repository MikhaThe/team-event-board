<% if (events.length === 0) { %>
  <div class="text-center py-12 text-slate-400">
    <p class="text-lg font-medium">No matching published events found.</p>
  </div>
<% } %>

<ul class="space-y-3">
  <% events.forEach((event) => { %>
    <li>
      <a href="/events/<%= event.id %>" class="block bg-white rounded-xl border border-slate-200 p-4 hover:shadow-md hover:border-blue-300 transition-all no-underline">
        <div class="flex items-start justify-between gap-3 flex-wrap">
          <div>
            <p class="font-semibold text-slate-900 text-base"><%= event.title %></p>
            <p class="text-sm text-slate-500 mt-0.5"><%= event.category %> · <%= event.startDatetime %></p>
          </div>
          <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold
            <%= event.status === 'published' ? 'bg-green-100 text-green-700' : 
                event.status === 'draft' ? 'bg-yellow-100 text-yellow-700' : 
                'bg-red-100 text-red-700' %>">
            <%= event.status %>
          </span>
        </div>
      </a>
    </li>
  <% }) %>
</ul>
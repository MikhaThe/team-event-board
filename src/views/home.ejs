<section class="mb-5 p-6 border border-slate-200 rounded-2xl bg-gradient-to-b from-white to-slate-50 shadow-lg">
  <h1 class="text-3xl font-bold text-slate-900 mb-3">Welcome to EventJunction!</h1>
  <p class="text-slate-500">
    You are signed in and ready to begin planning events. This home page is your first look into .
  </p>
  <% if (session.authenticatedUser) { %>
    <p class="text-slate-500 mt-2 mb-0">
      Signed in as <strong class="text-slate-700"><%= session.authenticatedUser.displayName %></strong>
      (<%= session.authenticatedUser.email %>, role:
      <strong class="text-slate-700"><%= session.authenticatedUser.role %></strong>).
    </p>
  <% } %>
</section>

<% if (pageError) { %>
  <%- include("partials/error", { message: pageError }) %>
<% } %>

<section class="p-6 border border-slate-200 rounded-2xl bg-white shadow-lg">
  <div class="mb-4">
    <h2 class="text-xl font-semibold mb-2">Getting Started</h2>
    <p class="text-slate-500">
      EventJunction is your #1 destination for local event planning, organization, and coordination. Here are some ideas for where to start:
    </p>
  </div>

  <div class = "min-h-48 justify-center gap-12 flex flex-wrap">
    <article class="bg-white rounded-xl shadow-sm border overflow-hidden transition-all duration-200 hover:shadow-md hover:-translate-y-0.5 flex-1">
      <div class="p-5">
        <h3 class="font-semibold">Create an Event</h3>
        <p class="text-sm text-slate-500 mt-1">Organizers can create event pages to spread awareness! You can also check events and update any details that need changing!</p>
        <div class="mt-4 flex gap-2">
        </div>
      </div>
    </article>
    <article class="bg-white rounded-xl shadow-sm border overflow-hidden transition-all duration-200 hover:shadow-md hover:-translate-y-0.5 flex-1">
      <div class="p-5">
        <h3 class="font-semibold">Check out Local Events</h3>
        <p class="text-sm text-slate-500 mt-1">Users can check out events happening in their area! You'll be waitlisted if an event has reached capacity. Feel free to cancel your RSVP if plans change!</p>
        <div class="mt-4 flex gap-2">
        </div>
      </div>
    </article>
    <article class="bg-white rounded-xl shadow-sm border overflow-hidden transition-all duration-200 hover:shadow-md hover:-translate-y-0.5 flex-1">
      <div class="p-5">
        <h3 class="font-semibold">Manage Your RSVPs and Events</h3>
        <p class="text-sm text-slate-500 mt-1">Users can look at the events they're attending, while Organizers can manage and publish their events!</p>
        <div class="mt-4 flex gap-2">
        </div>
      </div>
    </article>
  </div>
</section>
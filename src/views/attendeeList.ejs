<div id="attendee-list-panel"
     x-data="{ open: false }"
     class="mt-6 border-t border-slate-100 pt-6">

  <button
    x-on:click="open = !open"
    class="flex items-center gap-2 text-sm font-semibold text-blue-600
           hover:text-blue-700 transition-colors cursor-pointer">
    <span x-text="open ? 'Hide Attendee List' : 'View Attendee List'">
      View Attendee List
    </span>
    <svg x-bind:class="open ? 'rotate-180' : ''"
         class="w-4 h-4 transition-transform"
         fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round"
            stroke-width="2" d="M19 9l-7 7-7-7"/>
    </svg>
  </button>

  <div x-show="open"
       x-transition:enter="transition ease-out duration-200"
       x-transition:enter-start="opacity-0 -translate-y-1"
       x-transition:enter-end="opacity-100 translate-y-0"
       class="mt-4 space-y-4">

    <h2 class="text-xl font-bold text-slate-900">
      Attendees: <%= eventTitle %>
    </h2>

    <!-- ATTENDING -->
    <div class="bg-green-50 border border-green-200 rounded-xl overflow-hidden">
      <div class="px-4 py-3 border-b border-green-200">
        <h3 class="text-sm font-semibold text-green-700 uppercase tracking-wide">
          Attending (<%= going.length %>)
        </h3>
      </div>
      <% if (going.length === 0) { %>
        <p class="px-4 py-3 text-sm text-slate-400">No attendees yet.</p>
      <% } else { %>
        <ul class="divide-y divide-green-100">
          <% going.forEach(rsvp => { %>
            <li class="flex justify-between px-4 py-3 text-sm">
              <span class="font-medium text-slate-800"><%= rsvp.displayName %></span>
              <span class="text-slate-400">
                <%= new Date(rsvp.createdAt).toLocaleString() %>
              </span>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>

    <!-- WAITLISTED -->
    <div class="bg-yellow-50 border border-yellow-200 rounded-xl overflow-hidden">
      <div class="px-4 py-3 border-b border-yellow-200">
        <h3 class="text-sm font-semibold text-yellow-700 uppercase tracking-wide">
          Waitlisted (<%= waitlisted.length %>)
        </h3>
      </div>
      <% if (waitlisted.length === 0) { %>
        <p class="px-4 py-3 text-sm text-slate-400">No one on the waitlist.</p>
      <% } else { %>
        <ul class="divide-y divide-yellow-100">
          <% waitlisted.forEach((rsvp, index) => { %>
            <li class="flex justify-between px-4 py-3 text-sm">
              <span class="font-medium text-slate-800">
                #<%= index + 1 %> — <%= rsvp.displayName %>
              </span>
              <span class="text-slate-400">
                <%= new Date(rsvp.createdAt).toLocaleString() %>
              </span>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>

    <!-- CANCELLED -->
    <div class="bg-slate-50 border border-slate-200 rounded-xl overflow-hidden">
      <div class="px-4 py-3 border-b border-slate-200">
        <h3 class="text-sm font-semibold text-slate-400 uppercase tracking-wide">
          Cancelled (<%= cancelled.length %>)
        </h3>
      </div>
      <% if (cancelled.length === 0) { %>
        <p class="px-4 py-3 text-sm text-slate-400">No cancellations.</p>
      <% } else { %>
        <ul class="divide-y divide-slate-100">
          <% cancelled.forEach(rsvp => { %>
            <li class="flex justify-between px-4 py-3 text-sm text-slate-400">
              <span><%= rsvp.displayName %></span>
              <span><%= new Date(rsvp.createdAt).toLocaleString() %></span>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>

  </div>
</div>

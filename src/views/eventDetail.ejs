<h1><%= event.title %></h1>

<p><%= event.description %></p>

<p><strong>Location:</strong> <%= event.location %></p>
<p><strong>Category:</strong> <%= event.category %></p>
<p><strong>Status:</strong> <%= event.status %></p>
<p><strong>Organizer:</strong> <%= event.organizerName %></p>

<p><strong>Start:</strong> <%= event.startDatetime %></p>
<p><strong>End:</strong> <%= event.endDatetime %></p>

<p><strong>Attendance:</strong> <%= event.attendeeCount %>/<%= event.capacity ?? "No limit" %></p>

<% if (session.authenticatedUser &&
      (session.authenticatedUser.userId === event.organizerId ||
       session.authenticatedUser.role === "admin")) { %>
  <a href="/events/<%= event.id %>/attendees"
     class="inline-block mt-4 text-sm text-blue-600 hover:underline">
    View Attendee List
  </a>
<% } %>
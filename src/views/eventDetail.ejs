<%
  const userId = session.authenticatedUser?.userId;
  const userRole = session.authenticatedUser?.role;
  const isOwner = userId === event.organizerId;
  const isAdmin = userRole === 'admin';
  const canAct = (isOwner || isAdmin) && (event.status === 'draft' || event.status === 'published');
  const canEdit = isOwner || isAdmin;
%>

<div class="max-w-3xl mx-auto px-4 py-8">
  <div id="event-container">
    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">

      <!-- Header -->
      <div class="p-6 border-b border-slate-100">
        <div class="flex items-start justify-between gap-4 flex-wrap">
          <div class="flex-1 min-w-0">
            <h1 class="text-2xl font-bold text-slate-900 mb-1 truncate"><%= event.title %></h1>
            <p class="text-sm text-slate-500">Organized by <%= event.organizerName %></p>
          </div>
          <%- include('partials/eventStatusBadge', { event, canAct }) %>
        </div>
      </div>

      <!-- Info grid -->
      <div class="p-6 grid sm:grid-cols-2 gap-x-8 gap-y-5">
        <div class="bg-slate-50 rounded-xl p-4">
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-1">Location</p>
          <p class="text-slate-800 font-medium"><%= event.location %></p>
        </div>
        <div class="bg-slate-50 rounded-xl p-4">
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-1">Category</p>
          <p class="text-slate-800 font-medium"><%= event.category %></p>
        </div>
        <div class="bg-slate-50 rounded-xl p-4"
          x-data="{
            relativeTime: '',
            init() {
              const start = new Date('<%= event.startDatetime %>');
              const now = new Date();
              const diff = Math.round((start - now) / (1000 * 60 * 60 * 24));
              if (diff === 0) this.relativeTime = 'today';
              else if (diff === 1) this.relativeTime = 'tomorrow';
              else if (diff === -1) this.relativeTime = 'yesterday';
              else if (diff > 1) this.relativeTime = 'in ' + diff + ' days';
              else this.relativeTime = Math.abs(diff) + ' days ago';
            }
          }">
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-1">Starts</p>
          <p class="text-slate-800 font-medium"><%= new Date(event.startDatetime).toLocaleDateString("en-US", { weekday: "short", month: "short", day: "numeric", year: "numeric", hour: "numeric", minute: "2-digit" }) %></p>
          <p class="text-blue-600 text-sm mt-1" x-text="relativeTime"></p>
        </div>
        <div class="bg-slate-50 rounded-xl p-4">
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-1">Ends</p>
          <p class="text-slate-800 font-medium"><%= new Date(event.endDatetime).toLocaleDateString("en-US", { weekday: "short", month: "short", day: "numeric", year: "numeric", hour: "numeric", minute: "2-digit" }) %></p>
        </div>
        <div class="bg-slate-50 rounded-xl p-4 sm:col-span-2">
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-1">Attendance</p>
          <div class="flex items-center gap-3">
            <p class="text-slate-800 font-medium">
              <span class="font-semibold text-slate-900"><%= event.attendeeCount %></span>
              <% if (event.capacity) { %>/ <%= event.capacity %> attending<% } else { %> attending &middot; no capacity limit<% } %>
            </p>
            <% if (event.capacity) { %>
              <div class="flex-1 bg-slate-200 rounded-full h-2">
                <div class="bg-blue-500 h-2 rounded-full" style="width: <%= Math.min(100, Math.round((event.attendeeCount / event.capacity) * 100)) %>%"></div>
              </div>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Description -->
      <div class="px-6 pb-6">
        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-2">About</p>
        <p class="text-slate-700 leading-relaxed"><%= event.description %></p>
      </div>

      <!-- Actions -->
      <div class="px-6 py-4 border-t border-slate-100 flex flex-wrap items-center gap-3">
        <% if (canEdit) { %>
          <button
            hx-get="/events/<%= event.id %>/edit"
            hx-target="#event-container"
            hx-swap="innerHTML"
            class="px-4 py-2 rounded-lg bg-slate-100 text-slate-700 text-sm font-medium hover:bg-slate-200 transition-colors cursor-pointer">
            Edit
          </button>
        <% } %>
        <div id="rsvp-container">
          <%- include('partials/rsvpButton', {
            eventId: event.id,
            capacity: event.capacity ?? 0,
            attendeeCount: event.attendeeCount,
            rsvpStatus: rsvpStatus,
            error: null
          }) %>
        </div>
      </div>

      <!-- Attendee list (organizer/admin only) -->
      <% if (canEdit) { %>
        <div id="attendee-list-section" class="px-6 pb-6 border-t border-slate-100 pt-4">
          <button
            hx-get="/events/<%= event.id %>/attendees"
            hx-target="#attendee-list-section"
            hx-swap="outerHTML"
            class="flex items-center gap-2 text-sm font-semibold text-blue-600 hover:text-blue-700 transition-colors cursor-pointer bg-transparent border-none p-0">
            View Attendee List
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
        </div>
      <% } %>

    </div>
  </div>
</div>

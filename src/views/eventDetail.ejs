<%
  const userId = session.authenticatedUser?.userId;
  const userRole = session.authenticatedUser?.role;
  const isOwner = userId === event.organizerId;
  const isAdmin = userRole === 'admin';
  const canAct = (isOwner || isAdmin) && (event.status === 'draft' || event.status === 'published');
  const canEdit = isOwner || isAdmin;
%>

<div class="max-w-3xl mx-auto px-4 py-8">
  <div id="event-container">
    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">

      <!-- Header -->
      <div class="p-6 border-b border-slate-100">
        <div class="flex items-start justify-between gap-4 flex-wrap">
          <div class="flex-1 min-w-0">
            <h1 class="text-2xl font-bold text-slate-900 mb-1 truncate"><%= event.title %></h1>
            <p class="text-sm text-slate-500">Organized by <%= event.organizerName %></p>
          </div>
          <%- include('partials/eventStatusBadge', { event, canAct }) %>
        </div>
      </div>

      <!-- Info grid -->
      <div class="p-6 grid sm:grid-cols-2 gap-x-8 gap-y-5">
        <div>
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-1">Location</p>
          <p class="text-slate-700"><%= event.location %></p>
        </div>
        <div>
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-1">Category</p>
          <p class="text-slate-700"><%= event.category %></p>
        </div>
        <div>
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-1">Starts</p>
          <p class="text-slate-700"><%= new Date(event.startDatetime).toLocaleDateString("en-US", { weekday: "short", month: "short", day: "numeric", year: "numeric", hour: "numeric", minute: "2-digit" }) %></p>
        </div>
        <div>
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-1">Ends</p>
          <p class="text-slate-700"><%= new Date(event.endDatetime).toLocaleDateString("en-US", { weekday: "short", month: "short", day: "numeric", year: "numeric", hour: "numeric", minute: "2-digit" }) %></p>
        </div>
        <div>
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-1">Attendance</p>
          <p class="text-slate-700">
            <span class="font-semibold text-slate-900"><%= event.attendeeCount %></span>
            <% if (event.capacity) { %>
              / <%= event.capacity %> attending
            <% } else { %>
              attending &middot; no capacity limit
            <% } %>
          </p>
        </div>
      </div>

      <!-- Description -->
      <div class="px-6 pb-6">
        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-2">About</p>
        <p class="text-slate-700 leading-relaxed"><%= event.description %></p>
      </div>

      <!-- Actions -->
      <div class="px-6 py-4 border-t border-slate-100 flex flex-wrap items-center gap-3">
        <% if (canEdit) { %>
          <button
            hx-get="/events/<%= event.id %>/edit"
            hx-target="#event-container"
            hx-swap="innerHTML"
            class="px-4 py-2 rounded-lg bg-slate-100 text-slate-700 text-sm font-medium hover:bg-slate-200 transition-colors cursor-pointer">
            Edit
          </button>
        <% } %>
        <div id="rsvp-container">
          <%- include('partials/rsvpButton', {
            eventId: event.id,
            capacity: event.capacity ?? 0,
            rsvpStatus: rsvpStatus,
            error: null
          }) %>
        </div>
      </div>

    </div>
  </div>
</div>

<div x-data="{ 
  category: '<%= selectedCategory %>',
  date: '<%= selectedDate %>',
  get hasFilters() { return this.category !== '' || this.date !== '' }
}">

  <div class="flex items-center justify-between mb-6 flex-wrap gap-3">
    <h1 class="text-2xl font-bold text-slate-900">Events</h1>
    <button
      x-show="hasFilters"
      x-cloak
      @click="category = ''; date = ''; document.getElementById('category').value = ''; document.getElementById('date').value = ''; htmx.ajax('GET', '/events', {target: '#event-list', swap: 'innerHTML'})"
      class="px-3 py-1.5 rounded-lg text-sm font-medium bg-red-50 text-red-600 border border-red-200 hover:bg-red-100 cursor-pointer">
      Clear filters ×
    </button>
  </div>

  <form id="filter-form" class="flex flex-wrap gap-3 mb-6">
    <div class="flex flex-col gap-1">
      <label for="category" class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Category</label>
      <input
        type="text"
        id="category"
        name="category"
        value="<%= selectedCategory %>"
        placeholder="e.g. Music"
        x-model="category"
        hx-get="/events"
        hx-trigger="input changed delay:300ms"
        hx-target="#event-list"
        hx-swap="innerHTML"
        hx-include="#filter-form"
        hx-push-url="true"
        class="px-3 py-2 rounded-lg border border-slate-200 bg-white text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400"
        :class="category !== '' ? 'border-blue-400 ring-2 ring-blue-200' : ''"
      />
    </div>

    <div class="flex flex-col gap-1">
      <label for="date" class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Date</label>
      <input
        type="date"
        id="date"
        name="date"
        value="<%= selectedDate %>"
        x-model="date"
        hx-get="/events"
        hx-trigger="change"
        hx-target="#event-list"
        hx-swap="innerHTML"
        hx-include="#filter-form"
        hx-push-url="true"
        class="px-3 py-2 rounded-lg border border-slate-200 bg-white text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400"
        :class="date !== '' ? 'border-blue-400 ring-2 ring-blue-200' : ''"
      />
    </div>
  </form>

  <form id="searchbar" class="mb-6">
    <input
      type="text"
      id="search"
      placeholder="Search events..."
      name="q"
      value="<%= searchTerm %>"
      hx-get="/events/search"
      hx-trigger="input changed delay:300ms"
      hx-target="#event-list"
      hx-swap="innerHTML"
      hx-include="#searchbar"
      hx-push-url="true"
      class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-white text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400"
    />
  </form>

  <hr class="border-slate-200 mb-6" />

  <div id="event-list">
    <%- include('partials/event-list', { events: events }) %>
  </div>
</div>
<h1>Events</h1>

<form id="filter-form">
  <div>
    <label for="category">Category:</label>
    <input
      type="text"
      id="category"
      name="category"
      value="<%= selectedCategory %>"
      hx-get="/events"
      hx-trigger="input changed delay:300ms"
      hx-target="#event-list"
      hx-swap="innerHTML"
      hx-include="#filter-form"
      hx-push-url="true"
    />
  </div>

  <div>
    <label for="date">Date:</label>
    <input
      type="date"
      id="date"
      name="date"
      value="<%= selectedDate %>"
      hx-get="/events"
      hx-trigger="change"
      hx-target="#event-list"
      hx-swap="innerHTML"
      hx-include="#filter-form"
      hx-push-url="true"
    />
  </div>
</form>

<hr />

<div id="event-list">
  <%- include('partials/event-list', { events: events }) %>
</div>
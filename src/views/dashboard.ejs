<body>
  <h1>Your Dashboard</h1>

  <!-- Refresh button -->
  <button 
    hx-get="/dashboard"
    hx-target="#dashboard-content"
    hx-swap="outerHTML">
    Refresh
  </button>

  <!-- Auto-refresh every 30s -->
  <div
    id="dashboard-content"
    hx-get="/dashboard"
    hx-trigger="load, every 30s"
    hx-swap="outerHTML"
  >
    <%- include("partials/dashboardContent") %>
  </div>
</body>
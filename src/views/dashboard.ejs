<div class="space-y-6">

  <!-- Header -->
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-slate-900">Your Dashboard</h1>

    <button
      hx-get="/rsvpdashboard"
      hx-target="#rsvpdashboard-content"
      hx-swap="outerHTML"
      class="px-4 py-2 rounded-lg bg-blue-600 text-white text-sm font-medium hover:bg-blue-700"
    >
      Refresh
    </button>
  </div>

  <!-- Dashboard Content (HTMX Target) -->
  <div
    id="rsvpdashboard-content"
    hx-get="/rsvpdashboard"
    hx-trigger="load, every s"
    hx-swap="outerHTML"
    class="space-y-6"
  >
    <%- include("partials/dashboardContent") %>
  </div>

</div>
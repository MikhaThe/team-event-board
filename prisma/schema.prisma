generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Event {
  id            String   @id @default(uuid())
  title         String
  description   String
  location      String
  category      String
  status        String   @default("draft")
  organizerId   String
  organizerName String
  startDatetime String
  endDatetime   String
  attendeeCount Int      @default(0)
  capacity      Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum RSVPStatus {
  going
  waitlisted
  cancelled
}

model RSVP {
  userId    String
  eventId   String
  status    RSVPStatus?
  id        String      @id
  createdAt DateTime    @default(now())
}

model EventComment {
  id          String   @id @default(uuid())
  eventId     String
  userId      String
  userName    String
  body        String
  isOrganizer Boolean  @default(false)
  createdAt   DateTime @default(now())
}

